# Angel One SmartAPI (leave blank to run in yfinance Fallback Mode)
ANGEL_API_KEY=your_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=your_4_digit_pin
ANGEL_TOTP_SECRET=your_totp_secret

# Optional Telegram push alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live scan interval in seconds
SCAN_INTERVAL_SEC=10
